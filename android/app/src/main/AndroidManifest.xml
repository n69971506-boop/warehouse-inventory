<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application android:label="@string/app_name" android:icon="@drawable/warehouse_icon"
        android:roundIcon="@drawable/warehouse_icon" android:theme="@style/WarehouseTheme" android:hardwareAccelerated="true"
        android:allowBackup="false" android:usesCleartextTraffic="true">
        <activity android:name=".MainActivity" android:exported="true" android:theme="@style/WarehouseLaunchTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".WarehouseCaptureActivity" android:exported="false"
            android:screenOrientation="portrait" android:theme="@style/zxing_CaptureTheme"/>
    </application>
</manifest>
